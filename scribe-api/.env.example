# Scribe API — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Server port
PORT=8000

# Redis connection URL
# Local:      redis://localhost:6379
# With auth:  redis://:yourpassword@yourhost:6379
REDIS_URL=redis://localhost:6379

# Query analytics log directory
# Relative path → resolved from scribe-api/ folder
# Absolute path → e.g. /var/log/scribe  (recommended for production)
LOGS_DIR=./logs

# Reserved for future use (auth not currently active)
JWT_SECRET=change-me-in-production
